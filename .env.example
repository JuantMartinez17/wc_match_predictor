# Copia este archivo como .env y ajusta los valores.
# En producción, configura estas variables directamente en el panel de Render/Railway.

# URLs del frontend separadas por coma (sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# (Opcional) Regex para orígenes dinámicos — previews de Vercel por PR.
# Ej: https://<proyecto>-git-<branch>-<scope>.vercel.app
# CORS_ORIGIN_REGEX=https://wc-match-predictor.*\.vercel\.app
